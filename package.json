{
  "name": "@marcus-campos/parley",
  "version": "0.8.1",
  "description": "Coordination bus for concurrent agent sessions in one repository",
  "license": "MIT",
  "type": "module",
  "bin": {
    "parley": "./dist/parley"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build --compile --minify src/cli/main.ts --outfile dist/parley",
    "docs:commands": "bun run scripts/gen-commands.ts --write",
    "docs:citations": "bun run scripts/gen-citations.ts --write",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "bench:recall": "bun run scripts/bench-recall.ts"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "keywords": [
    "agents",
    "coordination",
    "claude-code",
    "mcp",
    "multi-agent"
  ],
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "mermaid": "^11.17.0",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17"
  }
}
